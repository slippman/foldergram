# Runtime
NODE_ENV=development

# Ports
SERVER_PORT=4141 # Production only
DEV_SERVER_PORT=4140
DEV_CLIENT_PORT=4141
# Optional comma-separated hostnames for a development reverse proxy
# DEV_ALLOWED_HOSTS=photos.example.net

# Storage paths
DATA_ROOT=./data
GALLERY_ROOT=./data/gallery
DB_DIR=./data/db
THUMBNAILS_DIR=./data/thumbnails
PREVIEWS_DIR=./data/previews

# Optional: comma-separated folder rules by name or exact relative path, for example @eaDir,thumbnails,Archive/cache
GALLERY_EXCLUDED_FOLDERS=

# Media behavior
# Controls what the image detail page loads: 'preview' (default) or 'original'
IMAGE_DETAIL_SOURCE=preview
# Controls when thumbnails/previews are generated: 'eager' (default, at scan time) or 'lazy' (on first request)
DERIVATIVE_MODE=eager
# Opt in to unguessable media URLs cacheable by browsers and CDNs in all views.
# Cached copies may remain accessible after access is revoked. Metadata stays private.
MEDIA_CACHE_ENABLED=false
# Shared browser/CDN lifetime in seconds (1–604800). 86400 = 24 hours.
MEDIA_CACHE_TTL_SECONDS=86400

# Scan and logging
LOG_VERBOSE=0
# Controls scan-time supported-media failures: 'skip' (default, report and continue) or 'fail' (stop on first error)
SCAN_MEDIA_ERROR_MODE=skip
SCAN_DISCOVERY_CONCURRENCY=4
SCAN_DERIVATIVE_CONCURRENCY=4

# Access control
PUBLIC_DEMO_MODE=0
CSRF_TRUSTED_ORIGINS=
# Production defaults to requiring initialized authentication. Never disable this on a public host.
# To initialize a NEW local installation, temporarily use AUTH_REQUIRED=false on loopback,
# set an admin password in Settings, then require authentication before exposing it.
# AUTH_REQUIRED=true

# Optional invite-only email sign-in (requires an initialized admin password).
# See docs/email-access.md. Sessions last a fixed 90 days.
EMAIL_SIGN_IN_ENABLED=false
# Later rollout phase: optional screen name on first sign-in.
EMAIL_SCREEN_NAMES_ENABLED=false
# EMAIL_SIGN_IN_ORIGIN=https://photos.example.com
# EMAIL_FROM=photos@example.com
# Optional owner inbox for access-request approval emails (links work without admin sign-in).
# EMAIL_ACCESS_REVIEW_TO=owner@example.com
# RESEND_API_KEY=your-private-sending-key

# Calendar day used for per-account album-view metrics.
ACTIVITY_TIMEZONE=UTC
